<Window x:Class="RevitCataloniaChecker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building Code Checker (AI BIM)" 
        Height="800" Width="1200" 
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#181825"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#252538"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Region -->
            <RowDefinition Height="Auto"/> <!-- Tools & Filters -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="180"/>  <!-- AI Insights -->
            <RowDefinition Height="Auto"/> <!-- Settings -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header and Region -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="ðŸŒ Regional Building Code Checker" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,5"/>
                    <TextBlock Text="Automatic compliance verification based on national and local regulations." Foreground="#A6ADC8" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="Country:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbCountry" Width="150" SelectionChanged="OnCountrySelectionChanged">
                        <ComboBoxItem Content="Spain"/>
                        <ComboBoxItem Content="Ø§ÛŒØ±Ø§Ù† (Iran)" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Province/Region:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbProvince" Width="150"/>
                </StackPanel>

                <Button Grid.Column="3" Content="ðŸ” Scan Model" Background="#89B4FA" Foreground="#11111B" Click="OnRescanClicked" Padding="20,10" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- 2. Tools & Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox x:Name="TxtSearch" Width="300" Height="32" Padding="10,6" HorizontalAlignment="Left"
                     Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                     TextChanged="OnSearchTextChanged" />
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="âœ¨ AI Analysis" Click="OnAiAnalyzeClicked" Margin="0,0,10,0" Background="#CBA6F7" Foreground="#11111B"/>
                <ComboBox x:Name="CmbFilter" Width="160" Height="32" SelectionChanged="OnFilterSelectionChanged">
                    <ComboBoxItem Content="Show All"/>
                    <ComboBoxItem Content="Only Violations" IsSelected="True"/>
                    <ComboBoxItem Content="Only Compliant"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 3. Compliance DataGrid -->
        <Border Grid.Row="2" CornerRadius="8" Background="#1E1E2E" Padding="5" Margin="0,0,0,15">
            <DataGrid x:Name="GridCompliance" AutoGenerateColumns="False" 
                      IsReadOnly="False" SelectionMode="Single"
                      SelectionChanged="OnGridSelectionChanged">
                <DataGrid.Columns>
                    <!-- Resolved CheckBox -->
                    <DataGridTemplateColumn Header="Resolved âœ…" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsResolved, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Checked="OnResolvedChecked" Unchecked="OnResolvedChecked"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Type" Binding="{Binding ElementType}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Element Name" Binding="{Binding ElementIdentifier}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterChecked}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Measured" Binding="{Binding MeasuredValue}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Req." Binding="{Binding RequiredValue}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Regulation / Law" Binding="{Binding RegulationReference}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Findings" Binding="{Binding Message}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

                <!-- 4. AI Insights Panel -->
        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="🤖 AI Architectural Consultant" FontWeight="Bold" FontSize="14" Foreground="#F9E2AF"/>
                    <TextBlock Text=" — Click 'AI Analysis' to start, then ask any follow-up questions." 
                               FontSize="12" Foreground="#6C7086" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundColor}" CornerRadius="6" Padding="10" Margin="0,5,0,5" HorizontalAlignment="{Binding Alignment}" MaxWidth="600">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding ForegroundColor}" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                                  <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Content="📎 CSV" Width="60" Margin="0,0,10,0" Background="#A6E3A1" Foreground="#11111B" Click="OnUploadCsvClicked" ToolTip="Upload Price List"/>
                      <TextBox x:Name="TxtChatInput" Grid.Column="1" Height="35" Padding="10,8" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" KeyDown="OnChatInputKeyDown"/>
                      <Button Grid.Column="2" Content="Send" Width="80" Margin="10,0,0,0" Background="#89B4FA" Foreground="#11111B" Click="OnSendChatClicked"/>
                  </Grid>
            </Grid>
        </Border>

                <!-- 4.5 Settings -->
        <Border Grid.Row="4" Background="#1E1E2E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Expander Header="⚙ Settings (API Key)" Foreground="#A6ADC8" ExpandDirection="Down">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Gemini API Key:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtApiKey" Grid.Column="1" Height="25" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Padding="5"/>
                    <Button Grid.Column="2" Content="Save" Width="60" Margin="10,0,0,0" Background="#A6E3A1" Foreground="#11111B" Click="OnSaveApiKeyClicked"/>
                </Grid>
            </Expander>
        </Border>

        <!-- 5. Footer Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="ðŸ“Œ Hint: Non-compliant elements are colored RED on your active plan. Check 'Resolved' to clear the color." 
                       Foreground="#6C7086" VerticalAlignment="Center" FontSize="12"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="ðŸ“ Export Markdown" Click="OnExportMarkdownClicked" Margin="0,0,10,0"/>
                <Button Content="ðŸ“Š Export CSV" Click="OnExportCsvClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>




